[bar/main]
width = 100%
height = 20px

background = %@colors.bg%
foreground = %@colors.fg%

padding = 10px

font-0 = "%@ui.font%:size=9;2"

modules-left = bspwm title
modules-center = date
modules-right = pulseaudio

separator = "  "

wm-restack = bspwm

[module/bspwm]
type = internal/bspwm

label-focused = "󰝥 "
label-focused-foreground = %@colors.accent%

label-occupied = "󰝥 "
label-occupied-foreground = %@colors.fg%

label-empty = "󰝦 "
label-empty-foreground = %@colors.fg-alt%

label-separator =

[module/title]
type = internal/xwindow

label = %title%
label-maxlen = 50

label-empty = Desktop
label-empty-foreground = %@colors.fg-alt%

[module/date]
type = internal/date

interval = 1.0

date = %Y-%m-%d %H:%M
date-alt = %A, %d %B %Y %H:%M:%S

[module/pulseaudio]
type = internal/pulseaudio
format-volume = <ramp-volume> <label-volume>

label-muted = 󰖁 muted
label-muted-foreground = %@colors.fg-alt%

ramp-volume-0 = 󰕿
ramp-volume-1 = 󰖀
ramp-volume-2 = 󰕾
