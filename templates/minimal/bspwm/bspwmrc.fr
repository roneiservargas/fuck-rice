#!/bin/bash

pkill sxhkd; sxhkd &
pkill picom; picom &
pkill polybar; polybar &

bspc monitor -d 1 2 3 4

bspc config border_width 2
bspc config window_gap 10

bspc config split_ratio 0.52
bspc config borderless_monocle true
bspc config gapless_monocle true

bspc config normal_border_color "%@colors.bg-alt%"
bspc config focused_border_color "%@colors.accent%"
bspc config presel_feedback_color "%@colors.accent%"

bspc config focus_follows_pointer true

xsetroot -cursor_name left_ptr
feh --bg-fill /home/admin/.config/wallpaper.jpg
